<?xml version="1.0" encoding="UTF-8"?>
<!--
  spring-app: the library REST API. Dependencies are added phase by phase.
  Starters are curated dependency bundles; since Spring Boot 4 they are split per technology
  (webmvc, data-jpa, flyway...), each with a matching "-test" starter for its test slice.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.playground</groupId>
        <artifactId>java-playground</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>spring-app</artifactId>
    <name>spring-app</name>
    <description>Library REST API built with Spring Boot</description>

    <properties>
        <!-- Empty default so @{argLine} below resolves; JaCoCo's prepare-agent fills it with its agent. -->
        <argLine/>
    </properties>

    <dependencies>
        <!-- Spring MVC + Jackson + embedded Tomcat. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <!-- Generates the OpenAPI document (/v3/api-docs) from the controllers and serves Swagger UI. -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- Bean Validation (Jakarta Validation API + Hibernate Validator): @Valid, @NotBlank... Guide: §5.3. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- JPA (Hibernate) + Spring Data repositories + a JDBC connection pool (HikariCP). Guide: §5.4. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Flyway runs the SQL migrations in db/migration at startup. The second artifact is
             Flyway's PostgreSQL support, split out of the core since Flyway 10. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- Spring Security (the filter chain, authentication, method security) and the OAuth2
             resource server: it validates the JWT bearer token on each request. Guide: §5.7. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-oauth2-resource-server</artifactId>
        </dependency>

        <!-- RestClient and HTTP interfaces (@HttpExchange) for calling other services: Open Library
             (§5.9). Boot configures the underlying HTTP client (here the JDK HttpClient). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-restclient</artifactId>
        </dependency>

        <!-- The cache abstraction (@Cacheable). With no cache library on the classpath, Boot uses an
             in-memory ConcurrentHashMap per cache. Guide: §5.9. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>

        <!-- Production endpoints under /actuator: health, info, metrics... (§5.9). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- The JDBC driver: only needed at runtime, the code never imports it. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Starts compose.yaml on spring-boot:run and points the DataSource at it. Optional, so it
             is left out of the packaged jar (a real deployment has its own database). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-docker-compose</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

        <!-- JUnit, AssertJ, Mockito, Spring Test and the MVC test slice. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Boot 4 test starter paired with the validation starter (start.spring.io adds it). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- The @DataJpaTest slice, and Flyway's test starter (start.spring.io pairs them). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- @WithMockUser, jwt() and the other Spring Security test helpers (start.spring.io pairs
             one test starter with each security starter). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-oauth2-resource-server-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Test starters paired with restclient (@RestClientTest, MockRestServiceServer), cache and
             actuator (start.spring.io adds them). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-restclient-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Throwaway PostgreSQL containers for the *IT tests; @ServiceConnection wires them in. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
              Mockito instruments classes through a Java agent. Loading it dynamically at runtime
              prints a warning on recent JDKs (and will be blocked in a future release), so the
              agent is passed explicitly to the test JVMs. The `properties` goal exposes each
              dependency's jar path as a property such as ${org.mockito:mockito-core:jar}.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>properties</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>@{argLine} -javaagent:${org.mockito:mockito-core:jar}</argLine>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <argLine>@{argLine} -javaagent:${org.mockito:mockito-core:jar}</argLine>
                </configuration>
            </plugin>
            <!--
              JaCoCo measures which lines and branches the tests run. prepare-agent (start of the build)
              puts its Java agent into ${argLine}, which Surefire and Failsafe above already pass to their
              JVMs; both append to target/jacoco.exec. report runs after the ITs, so one report covers
              both kinds of test: target/site/jacoco/index.html. No threshold: a number to hit invites
              tests written for the number. Guide: §5.8 Testing.
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>post-integration-test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- Adds `spring-boot:run` and repackages the jar into an executable "fat jar". build-info writes
                 META-INF/build-info.properties (artifact, version, build time), which /actuator/info shows (§5.9). -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>build-info</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
